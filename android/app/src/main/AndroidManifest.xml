<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".JwWebViewActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 提醒兜底心跳（v2.30）：不依赖插件的排期，自己每 15 分钟醒一次，
             把"刚过期还没投递"的通知补投出去（系统把闹钟攒着时的兜底）。
             开机也重排一次，否则重启后心跳就断了。 -->
        <receiver
            android:name=".ReminderHeartbeat"
            android:exported="false">
            <intent-filter>
                <action android:name="com.unimate.app.REMINDER_TICK" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 单条提醒由本接收器校验原计划时刻：过期超过两分钟直接丢弃，防止启动后集中补发。 -->
        <receiver
            android:name=".ReminderAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.unimate.app.REMINDER_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- 提醒守护前台服务（v2.34）：带一条最低优先级静音通知保活，
             避免国产 ROM 的"后台冻结"把闹钟攒到用户打开 App 时才补发。
             可在「我的 → 通知设置」一键关闭。 -->
        <service
            android:name=".ReminderGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="reminder_delivery" />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- v2.67：Uni 语音输入已下线，录音权限一并移除（App 不再申请麦克风）。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+ 精确闹钟。缺它时 Capacitor 会降级为 set(AlarmManager.RTC)：
         非唤醒 + 非精确的批量闹钟，设备打盹期间不触发，等 App 被打开唤醒设备时一次性补发，
         表现为"后台不提醒、一打开全涌出"。用户可在通知设置里一键跳转授权。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!--
      v2.55：**USE_EXACT_ALARM —— 装上就自动授予，用户不用去系统设置里开**。

      依据（都是查过的，不是猜的）：
        · Android 官方《Schedule exact alarms are denied by default》：需要按日历/闹钟精确提醒的 App
          应当声明 USE_EXACT_ALARM，声明后**无需用户授权**（要求 targetSdk ≥ 33，本项目 targetSdk 34）；
        · 主流通知库 flutter_local_notifications 的 README 把两条路写得很清楚：
          SCHEDULE_EXACT_ALARM（要用户手动开）或 USE_EXACT_ALARM（自动获得）。
      真机证据：v2.53 的自检报告里 `精确闹钟授权：denied` —— 用户没去开，于是闹钟退化成"不精确"，
      到点会晚、Doze 下每 9 分钟才放行一条，表现就是"后台不提醒、一打开才补发"。

      ⚠️ 取舍（必须写清楚）：Google Play 对上架应用会审计这个权限（只允许日历/闹钟类应用）。
      本项目是**比赛作品、侧载 APK**，不走 Play，因此可以声明；将来若要上架，需要改回
      SCHEDULE_EXACT_ALARM + 引导用户手动授权（代码里两条路都保留：canScheduleExactAlarms() 为假时
      仍然降级到 setAndAllowWhileIdle）。
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!--
      v2.56：把提醒写进系统日历（**选择性功能，默认关**）。
      为什么需要：产品负责人不愿意开"允许后台运行"，于是国产 ROM 会把后台的 App 冻住，
      闹钟回调排队 → 提醒只能等他打开 App 才补发。写进系统日历后，**闹钟由系统日历 App 持有**
      （系统应用，不受我们被冻结影响），到点由它弹通知 —— 课程表类 App 通行的兜底做法。
      权限只在用户**主动打开「同步到系统日历」**时才申请；关掉开关会删除所有由本 App 写入的日程
      （靠 Events.CUSTOM_APP_PACKAGE 认领，绝不碰用户自己的日程）。
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 提醒类 App 的标准做法：请求加入电池优化白名单。
         查证结论：不豁免电池优化时，国产 ROM 上 AlarmManager 排的通知会根本不显示。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 提醒守护前台服务（v2.34）：Android 14 起需要声明用途类型与对应权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
</manifest>
