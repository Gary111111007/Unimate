{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unimate.local/schemas/intent.schema.json",
  "title": "intentExtraction",
  "description": "LLM 结构化解析的输出契约。逐字对应主规划 附录 C.2。\n【F3】运行时校验用手写代码（n8n Code 节点没有 ajv），两者必须同步——见验收用例 §13.1 #4，以及 tests/contract-consistency.test.mjs 的实际断言。\n【比赛口径】E12 未确认前 LLM 分支保持关闭，本 schema 只作为冻结的契约存在，不接任何模型。",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "slots", "confidence"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "schedule.today",
        "schedule.tomorrow",
        "schedule.week",
        "schedule.date",
        "weather.today",
        "weather.tomorrow",
        "weather.date",
        "notes.create",
        "notes.query",
        "notes.update",
        "notes.delete",
        "records.summary",
        "smalltalk",
        "unsupported"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dateRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "to": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        },
        "locationScope": { "type": "string", "enum": ["city", "explicit"] },
        "keyword": { "type": "string", "maxLength": 50 },
        "targetHint": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 50 },
        "content": { "type": "string", "maxLength": 500 },
        "remindAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
