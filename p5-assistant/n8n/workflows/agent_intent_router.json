    {
      "parameters": {
        "jsCode": "// ── Rule Intent（由 tools/gen-workflows.mjs 从 core/uni-core.ts 生成，勿手改）──\n// 规则表与 UniCore 同源；改了 UniCore 的 RULES 必须重跑生成器。\nconst INTENTS = [\"schedule.today\",\"schedule.tomorrow\",\"schedule.week\",\"schedule.date\",\"weather.today\",\"weather.tomorrow\",\"weather.date\",\"notes.create\",\"notes.query\",\"notes.update\",\"notes.delete\",\"records.summary\",\"smalltalk\",\"unsupported\"];\nconst UNSUPPORTED = [\"weather.today\",\"weather.tomorrow\",\"weather.date\",\"records.summary\",\"notes.update\",\"notes.delete\"];\nconst RULES = [\n  { intent: 'notes.create', prio: 20, re: new RegExp('(记一下|记下|帮我记|帮我写|加个记事|新建记事|提醒我)', '') },\n  { intent: 'notes.create', prio: 18, re: new RegExp('(今晚|今天|明天|后天|周[一二三四五六日天]|星期[一二三四五六日天]).{0,12}(\\\\d{1,2}\\\\s*点|\\\\d{1,2}\\\\s*[:：]\\\\s*\\\\d{2}).{0,24}(交|写|做|买|去|开|报|发|提交|复习|打卡|取|面|聊)', '') },\n  { intent: 'notes.delete', prio: 20, re: new RegExp('(删掉|删除|去掉).{0,6}(记事|笔记|那条|记录)', '') },\n  { intent: 'notes.update', prio: 20, re: new RegExp('(改一下|修改|改成).{0,6}(记事|笔记|那条)', '') },\n  { intent: 'schedule.today', prio: 16, re: new RegExp('(下一节|下节课|接下来.{0,4}(上什么|什么课|的课))', '') },\n  { intent: 'schedule.tomorrow', prio: 15, re: new RegExp('(明天|明日).{0,10}(几点|什么课|哪些课|有课|上课|课程|课表|安排|简报)', '') },\n  { intent: 'schedule.today', prio: 15, re: new RegExp('(今天|今日).{0,10}(几点|什么课|哪些课|有课|上课|课程|课表|安排|简报|总结|还有什么|剩什么|剩下)', '') },\n  { intent: 'schedule.week', prio: 15, re: new RegExp('(这周|本周|这个星期|这一周).{0,8}(几节课|多少节课|几节|几次课|几门课|几门|课程安排|课表|有课)', '') },\n  { intent: 'schedule.date', prio: 14, re: new RegExp('(有空|空闲|空档|有时间|冲突|撞(?:课|了)?)', '') },\n  { intent: 'schedule.date', prio: 12, re: new RegExp('(\\\\d{1,2}\\\\s*月\\\\s*\\\\d{1,2}\\\\s*[日号]|\\\\d{4}-\\\\d{1,2}-\\\\d{1,2}|周[一二三四五六日天]|星期[一二三四五六日天]).{0,8}(几点|什么课|有课|上课|课表|有空|空闲|冲突)', '') },\n  { intent: 'records.summary', prio: 15, re: new RegExp('(二课|第二课堂|第二学分).{0,8}(还差|差多少|多少分|够不够|进度|修满)', '') },\n  { intent: 'weather.tomorrow', prio: 15, re: new RegExp('(明天|明日).{0,8}(天气|下雨|下雪|气温|多少度|冷不冷|热不热|带伞)', '') },\n  { intent: 'weather.today', prio: 15, re: new RegExp('(今天|今日).{0,8}(天气|下雨|下雪|气温|多少度|冷不冷|热不热|带伞)', '') },\n  { intent: 'weather.date', prio: 12, re: new RegExp('(\\\\d{1,2}\\\\s*月\\\\s*\\\\d{1,2}\\\\s*[日号]).{0,8}(天气|下雨|气温|多少度)', '') },\n  { intent: 'notes.query', prio: 12, re: new RegExp('(我的记事|有哪些记事|记事里|笔记里|找一下.{0,6}(记事|笔记)|我记过什么|待办)', '') },\n  { intent: 'smalltalk', prio: 5, re: new RegExp('^\\\\s*(你好|您好|hi|hello|在吗|你是谁|你能干什么|你能做什么)\\\\s*[!！?？。.,，]*\\\\s*$', 'i') },\n];\n\nconst item = $input.first().json;\n\n// 文本归一化：NFKC 全角→半角、去零宽字符、折叠空白（与 UniCore 一致）\nconst text = String(item.text ?? '')\n  .normalize('NFKC')\n  .replace(/[\\u200B-\\u200D\\uFEFF\\u2060]/g, '')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nif (text.length === 0 || text.length > 500) {\n  return [{ json: { ...item, text, intent: 'unsupported', matchPrio: null, reason: 'E_SCHEMA' } }];\n}\n\n// 按 prio 降序取第一个命中\nlet intent = 'unsupported';\nlet matchPrio = null;\nfor (const r of RULES.slice().sort((a, b) => b.prio - a.prio)) {\n  if (r.re.test(text)) { intent = r.intent; matchPrio = r.prio; break; }\n}\n\n// 比赛 MVP 明确不覆盖的意图：保留 intent 以便观测，但标记为不支持\nconst unsupported = intent === 'unsupported' || UNSUPPORTED.indexOf(intent) >= 0;\n\nreturn [{ json: {\n  ...item,\n  text,\n  intent,\n  matchPrio,\n  unsupported,\n  llmUsed: false,          // 比赛 MVP：规则链路，零模型调用\n  cacheMode: 'disabled',   // 比赛 MVP：不建 cache_manager\n} }];\n"
      },
      "id": "00000000-0000-4000-8000-000000000010",
      "name": "Rule Intent",
      "type": "n8n-nodes-base.code",
